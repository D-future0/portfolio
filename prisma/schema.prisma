// Prisma 6 schema — multi-tenant portfolio platform
// One shared database, row-level tenant isolation. Every content row
// (Profile/Experience/Project/Certification) belongs to exactly one Tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js v5 required models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(TENANT)
  tenants       Tenant[]

  accounts      Account[]
  sessions      Session[]
  authTokens    AuthToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthToken {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose])
}

model RateLimitBucket {
  key String @id
  count Int @default(0)
  resetAt DateTime
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Tenancy ---

enum UserRole {
  ADMIN
  TENANT
}

enum PlanTier {
  FREE
  PRO
}

// A tenant is one portfolio instance. The owner is a User with role TENANT.
// The admin is a separate superuser (role ADMIN) who never owns a tenant.
model Tenant {
  id String @id @default(cuid())

  // Public address: /u/[slug]. Admin sets this at creation.
  slug  String @unique
  name  String
  title String  @default("Independent Professional")
  seoTitle String?
  seoDescription String?
  socialImageUrl String?
  profession String @default("consultant")
  template   String @default("editorial")
  onboardingCompleted Boolean @default(false)

  // Billing (Paystack). Forward-looking — nullable until paid.
  plan              PlanTier  @default(FREE)
  paystackCustomerCode String?
  paystackPlanCode    String?
  paystackSubscriptionCode String?
  paystackSubscriptionStatus String?
  trialStartedAt    DateTime?
  trialEndsAt       DateTime?
  trialReminder14SentAt DateTime?
  trialReminder7SentAt  DateTime?
  trialReminder3SentAt  DateTime?
  trialReminder1SentAt  DateTime?
  paystackWebhookLast DateTime?

  // Publish control. Edit-in-place: what the owner saves is live.
  // published=false => 404 for visitors, still editable by owner.
  published Boolean @default(true)

  // Admin approval. Set when the admin makes a tenant live.
  approvedAt DateTime?

  // The single owner of this tenant.
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile        Profile?
  experiences    Experience[]
  projects       Project[]
  certifications Certification[]
  subscriptions  Subscription[]
  billingEvents  BillingEvent[]
  testimonials   Testimonial[]
  services       Service[]
  caseStudies    CaseStudy[]
  contactMessages ContactMessage[]
  customDomains  CustomDomain[]
  analyticsEvents AnalyticsEvent[]
}

// --- Site content (all tenant-scoped) ---

model Profile {
  id String @default("profile")

  // Hero
  name       String  @default("Your Name")
  title      String  @default("Independent Professional")
  heroTagline String @default("Ideas worth making visible.")
  heroImageUrl String?

  // About
  bio String @default("Write a short professional bio here.")

  // Stats shown in hero (the "ledger tally")
  yearsExperience Int @default(0)
  clientsServed   Int @default(0)
  projectsDone    Int @default(0)

  // Contact
  contactEmail String  @default("you@example.com")
  phone        String?
  location     String?
  calendlyUrl  String?
  linkedinUrl  String?
  twitterUrl   String?
  resumeUrl    String?

  // Theme (the one design knob the admin/owner can change)
  accentColor String @default("#B08D57")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // "" is a migration sentinel: existing rows get this default from db push,
  // then seed.ts migrates them into the demo tenant.
  tenantId String @unique @default("")

  updatedAt DateTime @updatedAt

  @@id([id, tenantId])
}

model Experience {
  id          String   @id @default(cuid())
  company     String
  role        String
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  location    String?
  bullets     String[]
  order       Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // "" is a migration sentinel: existing rows get this default from db push,
  // then seed.ts migrates them into the demo tenant.
  tenantId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, tenantId])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  summary     String
  description String?
  client      String?
  imageUrl    String?
  tags        String[]
  order       Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // "" is a migration sentinel: existing rows get this default from db push,
  // then seed.ts migrates them into the demo tenant.
  tenantId String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, tenantId])
}

model Certification {
  id           String    @id @default(cuid())
  name         String
  issuer       String
  issueDate    DateTime?
  credentialUrl String?
  order        Int       @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, tenantId])
}

model Testimonial {
  id String @id @default(cuid())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  name String
  role String?
  company String?
  quote String
  order Int @default(0)
  published Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, order])
}

model Service {
  id String @id @default(cuid())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  name String
  description String
  priceLabel String?
  order Int @default(0)
  published Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId, order])
}

model CaseStudy {
  id String @id @default(cuid())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  slug String
  title String
  summary String
  challenge String?
  approach String?
  outcome String?
  imageUrl String?
  published Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, slug])
}

model ContactMessage {
  id String @id @default(cuid())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  name String
  email String
  message String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([tenantId, createdAt])
}

model CustomDomain {
  id String @id @default(cuid())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  hostname String @unique
  verifiedAt DateTime?
  verificationToken String
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id String @id @default(cuid())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String
  type String
  path String?
  target String?
  projectId String?
  sessionHash String?
  createdAt DateTime @default(now())
  @@index([tenantId, type, createdAt])
  @@index([tenantId, projectId, createdAt])
}

// --- Billing state (Paystack). Kept in our DB so the app can gate features
// without re-fetching Paystack on every request. Paystack is the source of
// truth; these rows are the cache. ---
model Plan {
  id String @id @default(cuid())

  // Our plan key, mirrored to Paystack plan name.
  key String @unique // "free" | "pro"

  // Paystack plan code, if one exists on the integration.
  paystackPlanCode String?

  // Amount in the smallest currency unit (e.g. kobo for NGN).
  amount   Int
  interval String // "monthly" | "annually"
  currency String @default("NGN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id String @id @default(cuid())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  paystackCustomerCode       String?
  paystackSubscriptionCode   String @unique
  paystackAuthorizationCode  String?
  paystackEmailToken         String?
  planCode                   String
  status                     String // active, trial, canceled, expired, etc.
  startsAt                   DateTime?
  endsAt                     DateTime?
  trialEndsAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BillingEvent {
  id String @id @default(cuid())
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantId String?
  eventId String @unique
  eventType String
  status String @default("received")
  payload Json
  processedAt DateTime?
  createdAt DateTime @default(now())
  @@index([tenantId, createdAt])
}