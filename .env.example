# --- Database ---
# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js v5 ---
# Generate with: npx auth secret
AUTH_SECRET=""

# --- Admin user (used only by `npm run db:seed`, not read at runtime) ---
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# --- Image and PDF uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Contact form email (Resend) ---
RESEND_API_KEY=""
# Must be a domain you've verified in Resend, or resend.dev for testing
CONTACT_FROM_EMAIL="portfolio@resend.dev"
